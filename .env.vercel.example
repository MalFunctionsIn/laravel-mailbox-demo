# Environment variables for a Vercel deployment.
#
# Paste the whole file into Vercel's "Import .env" box on the project's
# Environment Variables screen, then replace the two placeholders below.
#
# These are set in the DASHBOARD, not in vercel.json. The "env" key in
# vercel.json is not in Vercel's current property list and is documented
# elsewhere as legacy, so it cannot be relied on to reach the running app.
# There is no .env in this repository either, so the dashboard is the only
# source of configuration the app will see.
#
# Getting this wrong fails quietly rather than loudly: with no variables at
# all, APP_ENV falls back to "production", which makes the mailbox package
# switch itself off entirely, and MAIL_MAILER falls back to "log". The site
# loads, the buttons work, and nothing ever reaches the dashboard.

# --- Replace these two -------------------------------------------------------

# php artisan key:generate --show
APP_KEY=REPLACE_WITH_YOUR_APP_KEY

# Neon, Supabase or any Postgres/MySQL connection string. The file store cannot
# be used on Vercel: /tmp is not shared between invocations, so a captured
# message is gone before the dashboard reads it.
MAILBOX_DB_URL=REPLACE_WITH_YOUR_CONNECTION_STRING

# --- Everything below can be pasted as-is ------------------------------------

APP_NAME="Mailbox Demo"

# Must NOT be "production" — the package goes inert there by design.
APP_ENV=demo
APP_DEBUG=false

# storage/logs is read-only on Vercel; stderr reaches the log drain.
LOG_CHANNEL=stderr

# A file session writes the CSRF token in one invocation and validates it in
# another, which returns 419 on every button.
SESSION_DRIVER=cookie
CACHE_STORE=array
QUEUE_CONNECTION=sync

MAIL_MAILER=mailbox
MAIL_FROM_ADDRESS=shop@acme-store.test
MAIL_FROM_NAME="ACME Store"

MAILBOX_ENABLED=true
MAILBOX_STORE_DRIVER=database
MAILBOX_POLLING_INTERVAL=3000

# Attachment bytes need a writable disk, which Vercel does not provide. See
# VERCEL.md for the Cloudflare R2 config that turns the PDF receipt back on.
MAILBOX_ATTACHMENTS_ENABLED=false

# Opens /mailbox to anonymous visitors. Safe here because every message is a
# fake ACME Store order. Never set this on an app that sends real mail.
DEMO_PUBLIC_MAILBOX=true

# Set this to the deployment URL after the first deploy, then redeploy.
# APP_URL=https://your-project.vercel.app
